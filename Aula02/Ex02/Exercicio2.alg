Algoritmo "Exercicio2"
// Autor(a): Jorge Siqueira
// Data: 03/08/2026

//Ler o nome, e exibir mensagem de boas vindas

Var
// Seção de Declarações das variáveis
nome: caractere


Inicio
// Seção de Comandos
escreval("Digite seu nome: ")
leia(nome)

escreval("Boas vindas, ", nome, " voce esta no ITEAM")



fimalgoritmo